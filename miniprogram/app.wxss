@import './styles/tokens.wxss';
page {
  background: var(--color-background);
  color: var(--color-text);
  font-size: 28rpx;
}
.page {
  padding: 40rpx 32rpx;
}
.eyebrow {
  color: var(--color-primary);
  font-size: 24rpx;
  letter-spacing: 3rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 600;
  margin: 16rpx 0 24rpx;
}
.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.body {
  color: var(--color-muted);
  line-height: 1.8;
}
.badge {
  display: inline-block;
  background: #e9eef9;
  color: var(--color-primary);
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  margin: 8rpx 12rpx 8rpx 0;
}
.hint {
  margin-top: 24rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.6;
}
